# Authentication (optional). If neither is set, the app stays open.

# Recommended: store a scrypt hash (generate with: node hash-password.mjs <password>)
APP_PASSWORD_HASH=salt:hash

# Alternative (less secure): plaintext password
# APP_PASSWORD=your-password

# Vault location (optional).
# VAULT_PATH=/path/to/your/vault

# Optional overrides:
# SESSION_SECRET=<random-hex>   # set to keep sessions valid across server restarts
# SESSION_TTL_HOURS=168         # default: 7 days
